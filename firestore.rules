rules_version = '2';

// TravelBuddy v2 security rules (docs/DESIGN-v2.md §12).
//  - only approved (ACTIVE) members read anything beyond their own profile
//  - users write only their own profile fields, their own posts and their own live position
//  - rides, points, monthly totals and no-show reports are written ONLY by Cloud Functions
//  - live positions are readable only by the people in that ride
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me()     { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && me().accountStatus == 'ACTIVE'; }
    function admin()  { return active() && me().role == 'ADMIN'; }
    function changed(){ return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());

      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                         ['name','email','phone','employeeId','department','townshipLocation',
                          'hasCar','siteId','accountStatus','role','createdAt'])
                    && request.resource.data.accountStatus == 'PENDING'
                    && request.resource.data.role == 'USER';

      // Admin: approve / block / unblock + audit (never the role — set by hand in the console).
      // Self: profile fields, car flag, last role, push tokens. Points/noShows are server-only.
      allow update: if (admin() && request.auth.uid != uid
                        && changed().hasOnly(['accountStatus','audit','lastAdminActionAt'])
                        && request.resource.data.accountStatus in ['PENDING','ACTIVE','BLOCKED'])
                    || (signedIn() && request.auth.uid == uid
                        && changed().hasOnly(['name','phone','department','townshipLocation','hasCar','lastRole','fcmTokens']));

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /sites/{siteId} {
      allow read: if active();
      allow write: if admin();
    }

    match /posts/{postId} {
      function d() { return resource.data; }
      function n() { return request.resource.data; }
      allow read: if active();
      allow create: if active()
                    && n().userId == request.auth.uid
                    && n().kind in ['OFFER','REQUEST']
                    && n().status == 'OPEN'
                    && n().seats is int && n().seats >= 1 && n().seats <= 4
                    && n().seatsLeft == n().seats
                    && (n().kind == 'OFFER' || n().seats == 1)
                    && n().date is string && n().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && n().departAt is timestamp && n().deleteAt is timestamp
                    && n().siteId == me().siteId
                    && !('rideId' in n());
      // Owner may only toggle auto-accept or change the note; everything else is server-side.
      allow update: if active() && d().userId == request.auth.uid
                    && changed().hasOnly(['autoAccept','note']);
      allow delete: if admin();
    }

    match /rides/{rideId} {
      allow read: if active() && (request.auth.uid in resource.data.participantIds || admin());
      allow write: if false;   // Cloud Functions only

      // Live positions during a ride: participants read each other; each writes only their own.
      match /live/{uid} {
        function ride() { return get(/databases/$(db)/documents/rides/$(rideId)).data; }
        allow read: if active() && request.auth.uid in ride().participantIds;
        allow create, update: if active() && request.auth.uid == uid
                    && request.auth.uid in ride().participantIds
                    && ride().status in ['LOCKED','PICKED_UP']
                    && request.resource.data.keys().hasOnly(['lat','lng','at','deleteAt'])
                    && request.resource.data.lat is number && request.resource.data.lng is number;
        allow delete: if active() && request.auth.uid == uid;
      }
    }

    match /points/{entryId} {
      allow read: if active() && (resource.data.uid == request.auth.uid || admin());
      allow write: if false;
    }

    match /monthly/{docId} {
      allow read: if active();
      allow write: if false;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && changed().hasOnly(['read']);
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create: if false;
    }
  }
}
